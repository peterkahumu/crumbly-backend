DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/bakery_marketplace"

# Cloudinary (used by backend for image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Super admin bootstrapping (invite/setup email is sent to this address)
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL=""

# Baker credentials (used by dev seed script - leave empty in production)
BAKER_PASSWORD=""

# Frontend URL (used for password reset and admin invitation links)
FRONTEND_URL="http://localhost:3000"

# SMTP Email Configuration (used for sending password reset & invitation emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Crumbly Marketplace"
SMTP_TLS="true"
SMTP_SSL="false"

# JWT configuration (required in production)
JWT_SECRET="generate-a-strong-secret-key-for-production"

# CORS allowed origins (comma-separated if multiple, optional)
CORS_ORIGINS="http://localhost:3000"
